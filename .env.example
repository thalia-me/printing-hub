# ==============================================================================
# Dxlea Printing Hub - Environment Variables Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Project Configuration
# ------------------------------------------------------------------------------
# Obtain these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-secret-key

# Storage Bucket Name for customer uploads (default: order-files)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=order-files

# ------------------------------------------------------------------------------
# 2. Admin Authentication
# ------------------------------------------------------------------------------
# Comma-separated list of approved staff Supabase user email addresses.
# Only users signed in with an email in this list are granted admin dashboard access.
ADMIN_EMAILS=owner@dxleaprinting.com,staff@dxleaprinting.com

# ------------------------------------------------------------------------------
# 3. Canonical Website Address (REQUIRED for Production QR Codes)
# ------------------------------------------------------------------------------
# The canonical public URL for Dxlea Printing Hub (e.g. https://dxlea-printing.netlify.app)
# All poster QR codes, receipt QR codes, and customer links are built from this.
# Must NOT contain a trailing slash.
# In production, poster QR generation refuses localhost/private LAN IPs (192.168.x).
NEXT_PUBLIC_SITE_URL=https://your-domain.netlify.app

# ------------------------------------------------------------------------------
# 4. Storage Limits & Protection (Free Tier Safety)
# ------------------------------------------------------------------------------
# Maximum file size permitted per uploaded file in megabytes (default: 10)
MAX_UPLOAD_SIZE_MB=10

# Warning threshold percentage for Supabase 1 GB free-tier storage (default: 80)
# A warning banner appears on the Admin Dashboard when usage reaches this percentage.
STORAGE_WARNING_THRESHOLD_PERCENT=80

# ------------------------------------------------------------------------------
# 5. Production Safety & Demo Orders
# ------------------------------------------------------------------------------
# By default, demo orders are disabled in production (NODE_ENV=production).
# Set to 'true' only if you explicitly want mock orders populated in production.
ALLOW_DEMO_DATA=false
